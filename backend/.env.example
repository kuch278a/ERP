APP_NAME="ASHARA Atelier ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database — PostgreSQL (see docs/adr/0002-database-engine.md)
# AureusERP supports mysql, mariadb, and pgsql via its dialect layer.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ashara_erp
DB_USERNAME=postgres
DB_PASSWORD=

# Optional: a full connection URL overrides the discrete values above
# DB_URL=

# MySQL / MariaDB alternative (the shipped production Docker image uses MySQL)
# DB_CONNECTION=mariadb
# DB_PORT=3306
# DB_DATABASE=ashara_erp
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cache / session / queue
# ---------------------------------------------------------------------------
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Sanctum / app auth (SPA)
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173
