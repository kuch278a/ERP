# SPA environment (Vite). Only VITE_-prefixed vars reach the client.

# Base URL for the Laravel/AureusERP v1 REST API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# External ERP bridge (deprecated — see docs/adr/0001).
# Never place secrets here; they would ship to the browser bundle.
# VITE_ERPNEXT_URL=
